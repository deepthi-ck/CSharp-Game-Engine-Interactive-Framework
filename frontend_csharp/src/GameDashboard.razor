@namespace GameEngine.Frontend
@page "/"
@inject GameClient Client
@inject VersionInfo Version
@inject HttpClient Http
@implements IAsyncDisposable

<h1>C# Game Engine / Interactive Framework</h1>
<p><strong>Branch:</strong> @Version.Branch</p>
<p><strong>Frontend .NET:</strong> @Version.FrontendDotnet</p>
<p><strong>Backend .NET:</strong> @Version.BackendDotnet</p>

<section>
  <h2>Lobby / Room</h2>
  <label>Game Id <input @bind="gameId" /></label>
  <label>Player <input @bind="player" /></label>
  <label>Move <input @bind="move" /></label>
  <div>
    <button @onclick="Create">Create</button>
    <button @onclick="Join">Join</button>
    <button @onclick="Play">Play Move</button>
    <button @onclick="Refresh">Get State</button>
    <button @onclick="Leave">Leave/End</button>
    <button @onclick="LoadStats">Stats</button>
  </div>
</section>

<section>
  <h2>Status</h2>
  <p>@status</p>
  @if (!string.IsNullOrEmpty(Client.LastError))
  {
    <p style="color:darkred">Move/request: @Client.LastError</p>
  }
  else if (Client.LastGame is not null)
  {
    <p style="color:darkgreen">Last result accepted</p>
  }
  <pre>@gameJson</pre>
  <pre>@statsJson</pre>
</section>

@code {
    private string gameId = "game:1001";
    private string player = "Visvantha";
    private string move = "play:card-A";
    private string status = "Ready";
    private string gameJson = "{}";
    private string statsJson = "{}";

    protected override void OnInitialized()
    {
        Client.StateChanged += () => InvokeAsync(StateHasChanged);
    }

    private async Task Create()
    {
        var r = await Client.CreateAsync(gameId, player);
        status = r?.Message ?? "CREATE failed";
        gameJson = System.Text.Json.JsonSerializer.Serialize(r);
    }

    private async Task Join()
    {
        var r = await Client.JoinAsync(gameId, player);
        status = r?.Message ?? "JOIN failed";
        gameJson = System.Text.Json.JsonSerializer.Serialize(r);
    }

    private async Task Play()
    {
        var r = await Client.MoveAsync(gameId, player, move);
        status = r?.Message ?? "MOVE failed";
        gameJson = System.Text.Json.JsonSerializer.Serialize(r);
    }

    private async Task Refresh()
    {
        var r = await Client.GetAsync(gameId);
        status = r?.Message ?? "GET failed";
        gameJson = System.Text.Json.JsonSerializer.Serialize(r);
    }

    private async Task Leave()
    {
        var r = await Client.LeaveAsync(gameId);
        status = r?.Message ?? "LEAVE failed";
        gameJson = System.Text.Json.JsonSerializer.Serialize(r);
    }

    private async Task LoadStats()
    {
        var s = await Client.StatsAsync();
        statsJson = System.Text.Json.JsonSerializer.Serialize(s);
        status = "Stats loaded";
    }

    public ValueTask DisposeAsync() => Client.DisposeAsync();
}
